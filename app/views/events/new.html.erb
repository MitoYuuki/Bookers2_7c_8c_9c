<!-- イベントメール作成フォーム -->
<div class="d-flex flex-column align-items-center">
  <h1>Event Mail</h1>
  <%= form_with(model: [@group, @event]) do |f| %>
    <!-- タイトル -->
      <div class="mb-3" style="width: 500px;">
        <%= f.label :title, 'Title', class: "form-label" %>
        <%= f.text_field :title, class: "form-control" %>
      </div>

      <!-- コンテンツ -->
      <div class="mb-3" style="width: 500px;">
        <%= f.label :content, 'content', class: "form-label" %>
        <%= f.text_area :content, rows: 5, class: "form-control" %>
      </div>

      <!-- 送信ボタン -->
      <%= f.submit '送信', class: "btn btn-primary", style: "background-color: #00cfff; color: white;" %>

  <% end %>
<div>