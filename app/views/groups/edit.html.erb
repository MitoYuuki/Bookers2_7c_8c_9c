<!-- グループ編集フォーム -->
<div class="d-flex flex-column align-items-center">
  <h1>Editting Group</h1>
  <%= form_with(model: @group) do |f| %>
    <!-- グループ名 -->
      <div class="mb-3" style="width: 500px;">
        <%= f.label :name, 'グループ名', class: "form-label" %>
        <%= f.text_field :name, class: "form-control" %>
      </div>

      <!-- 紹介文 -->
      <div class="mb-3" style="width: 500px;">
        <%= f.label :introduction, '紹介文', class: "form-label" %>
        <%= f.text_area :introduction, rows: 5, class: "form-control" %>
      </div>

      <!-- グループ画像 -->
      <div class="mb-3">
        <%= f.label :introduction, 'グループ画像', class: "form-label" %><br>
        <%= f.file_field :igroup_image, accept: "image/*" %>
      </div>

      <%= f.submit 'Create Group', style: 'background-color: #00cfff; color: white;' %>

  <% end %>
<div>