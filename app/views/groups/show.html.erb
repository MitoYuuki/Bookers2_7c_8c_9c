<!-- グループ一覧画面 -->
<div class='container px-5 px-sm-0'>
  <div class='row'>
    <div class='col-md-3'>
      <h2>User info</h2>
      <%= render 'users/info', user: current_user %>
      <h2 class="mt-3">New book</h2>
      <%= render 'books/form', book: @book %>
    </div>

    <div class='col-md-8 offset-md-1'>
      <h2>Group Detail</h2>
      <table class='table table-hover table-inverse'>
        <thead>
          <tr>
            <th></th>
            <th>グループ名</th>
            <th>紹介文</th>
            <th>メンバー</th>
            <th colspan="3"></th>
          </tr>
        </thead>
        <tbody>
          <tr>
              <!-- 画像 -->
              <td>
                <% if @group.group_image.attached? %>
                  <%= image_tag @group.group_image, size: "50x50" %>
                <% else %>
                  <%= image_tag 'no_image', size: "50x50" %>
                <% end %>
              </td>

              <!-- グループ名 -->
              <td>
                <%= link_to @group.name, group_path(@group) %>
              </td>

              <!-- 紹介文 -->
              <td>
                <%= @group.introduction %>
              </td>

              <!-- メンバー -->
              <td><%= @group.owner.name %><br>
                <% @group.members.each do |member| %>
                  <%= member.name %>
                <% end %>
              </td>

              <!-- Editボタン（オーナーだけ表示） -->
              <td>
                <% if @group.owner == current_user %>
                  <%= link_to 'Edit', edit_group_path(@group), class: "btn btn-sm btn-primary" %>
                <% elsif @membership.present? %>
                  <%= link_to 'Leave this group', group_group_membership_path(@group, @membership.id), method: :delete, class: "btn btn-sm btn-danger" %>
                <% else %>
                  <%= link_to 'Join this group', group_group_memberships_path(@group), method: :post, class: "btn btn-sm btn-success" %>
                <% end %>
              </td>

              <!-- Notice an Event ボタン -->
              <td>
                <% if @group.owner == current_user %>
                  <%= link_to 'Notice an Event', new_group_event_path(@group), class: "btn btn-sm btn-info" %>
                <% end %>
              </td>

        </tbody>
      </table>
    </div>
  </div>
</div>

